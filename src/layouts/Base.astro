---
import '../styles/fonts.css';
import '../styles/global.css';
import site from '../data/site.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { HTML_LANG, OG_LOCALE, t, type Lang } from '../i18n';
import { alternates } from '../lib/routes';

interface Props {
  lang: Lang;
  /** 不含语言前缀的路径（用于 hreflang 与语言切换）；404 页不传 */
  path?: string;
  title: string;
  description: string;
  section?: 'apps' | 'books' | 'about' | 'contact';
  og?: string;
  noindex?: boolean;
  jsonld?: any[];
  bodyClass?: string;
}
const { lang, path, title, description, section, og = `/assets/og/default-${lang === 'zh' ? 'zh' : 'en'}.png`, noindex = false, jsonld = [], bodyClass } = Astro.props;
const T = t(lang);
const alts = path ? alternates(path) : {};
const self = path ? (lang === 'en' ? path : `/${lang}${path}`) : null;
const canonical = self ? new URL(self, site.url).href : null;
const fullTitle = title.includes('Shuye Lab') || title.includes('书叶') ? title : `${title} · ${lang === 'zh' ? '书叶工作室' : 'Shuye Lab'}`;
const ogUrl = new URL(og, site.url).href;
const gc = site.goatcounter;
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex">}
{canonical && <link rel="canonical" href={canonical}>}
{Object.entries(alts).map(([l, u]) => <link rel="alternate" hreflang={HTML_LANG[l as Lang]} href={new URL(u as string, site.url).href}>)}
{alts.en && <link rel="alternate" hreflang="x-default" href={new URL(alts.en, site.url).href}>}
<meta name="theme-color" content="#FAF6EE">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Shuye Lab · 书叶工作室">
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
{canonical && <meta property="og:url" content={canonical}>}
<meta property="og:image" content={ogUrl}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content={OG_LOCALE[lang]}>
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" href="/assets/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
{jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
{gc.enabled && <script is:inline data-goatcounter={`https://${gc.code}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js"></script>}
</head>
<body class={bodyClass}>
<a class="skip" href="#main">{T.skip}</a>
<Header lang={lang} path={path} section={section} />
<main id="main">
<slot />
</main>
<Footer lang={lang} />
</body>
</html>
