---
import Base from '../../layouts/Base.astro';
import { t, href, L, type Lang } from '../../i18n';
import { booksIn, bookPath } from '../../lib/routes';
const { lang, series } = Astro.props as { lang: Lang; series: any };
const T = t(lang); const zh = lang === 'zh';
const books = booksIn(series.slug);
---
<Base lang={lang} path={`/books/${series.slug}/`} title={zh ? `${series.name} 系列` : series.name} description={`${L(series.tagline, lang)} ${L(series.about, lang)}`.slice(0, 300)} section="books" og={`/assets/og/book-${books[0].slug}.png`}>
<div class="wrap crumbs"><a href={href(lang, '/books/')}>{T.crumbsBooks}</a> <span aria-hidden="true">/</span> <span aria-current="page" lang="en">{series.name}</span></div>
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">{zh ? '系列' : 'Series'}</span>
    <h1 lang="en">{series.name}</h1>
    <p class="lead big-lead">{L(series.tagline, lang)}</p>
    <p class="lead mt16">{L(series.about, lang)}</p>
  </div>
</section>
<section class="pt0">
  <div class="wrap">
    <h2 class="h2-sm mb32">{T.booksInSeries}</h2>
    <div class="book-list">
      {books.map((b) => (
        <article class="book-row">
          <a class="book-row-cover" href={href(lang, bookPath(b))} tabindex="-1" aria-hidden="true"><img src={`/assets/img/books/${b.slug}/cover-400.webp`} width="400" height="640" alt="" loading="lazy"></a>
          <div>
            <span class="sname">{L(b.number, lang)}</span>
            <h3><a href={href(lang, bookPath(b))} lang={zh ? 'zh-CN' : 'en'}>{zh ? b.zh_title : b.title}</a></h3>
            <p class="subtitle" lang="en">{b.subtitle}</p>
            <p>{L(b.summary, lang)}</p>
            <ul class="formats">{b.formats.map((f: any) => <li class={`tag${f.accent ? ' tag-jade' : ''}`}>{L(f, lang)}</li>)}</ul>
            <div class="buy"><a class="btn btn-ink" href={href(lang, bookPath(b))}>{T.viewBook} <span class="arr" aria-hidden="true">→</span></a>{b.amazon_url ? <a class="btn btn-line" href={b.amazon_url}>{T.buyAmazon}</a> : <span class="btn btn-soon">{T.amazonSoon}</span>}</div>
          </div>
        </article>))}
    </div>
    <p class="muted small mt24">{T.moreSoon}</p>
  </div>
</section>
<div class="spacer"></div>
</Base>
