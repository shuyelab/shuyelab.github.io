---
import { t, type Lang } from '../i18n';
const { lang, store = {} } = Astro.props as { lang: Lang; store?: any };
const T = t(lang);
const apple = 'M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.5-1-2.5-3.9zM14 5.5c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.6 2.8-1.4z';
const play = 'M4.2 2.6c-.3.3-.4.7-.4 1.2v16.4c0 .5.1.9.4 1.2l9.2-9.4-9.2-9.4zm10.4 8.2 2.6-2.6-10.9-6.3c-.4-.2-.8-.3-1.1-.2l9.4 9.1zm3.9-1.8-3 1.7-2.8 2.8 2.8 2.8 3 1.7c.9-.5.9-1.9 0-2.4zM6.3 21.9c.3.1.7 0 1.1-.2l10.9-6.3-2.6-2.6-9.4 9.1z';
const items = [
  { d: apple, name: T.appStore, url: store.app_store },
  { d: play, name: T.googlePlay, url: store.google_play },
];
---
<div class="badges">
  {items.map((i) => i.url ? (
    <a class="store-badge live" href={i.url}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={i.d}/></svg><span><small>{lang === 'zh' ? '下载' : 'Download on'}</small><b>{i.name}</b></span></a>
  ) : (
    <span class="store-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={i.d}/></svg><span><small>{T.comingSoon}</small><b>{i.name}</b></span></span>
  ))}
</div>
